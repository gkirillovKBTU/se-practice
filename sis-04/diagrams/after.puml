@startuml
title Smart Campus — final modular structure
skinparam componentStyle rectangle

component "main.tsx" as Main
component "App.tsx\nUI presentation" as App
component "rooms.ts\nRoom catalog" as Rooms
component "filter.ts\nCapacity + equipment rules" as Filter
component "booking.ts\nAvailability rules" as Booking
component "index.css" as Styles
component "rules.test.ts" as Tests

Main --> App : imports
Main --> Styles : imports
App --> Rooms : ROOMS, EQUIPMENT
App --> Filter : filterRooms
App --> Booking : checkRoom
Filter --> Rooms : Room type
Booking --> Rooms : Room, Booking types
Tests --> Filter : exercises
Tests --> Booking : exercises
@enduml
