@startuml
class Student {
  studentId: String
  name: String
}
class Course {
  code: String
  title: String
}
class CourseOffering {
  offeringId: String
  semester: String
  capacity: Integer
}
class Enrollment {
  enrollmentId: String
}

Student "1" -- "0..*" Enrollment : holds >
CourseOffering "1" -- "0..*" Enrollment : receives >
Course "1" -- "1..*" CourseOffering : is offered as >

note "Capacity (R2): Enrollment count for an offering must never exceed its positive capacity; available places are capacity minus that count." as N1
N1 .. CourseOffering
note "Uniqueness (R3): A Student may have at most one Enrollment in the same CourseOffering." as N2
N2 .. Enrollment
@enduml
